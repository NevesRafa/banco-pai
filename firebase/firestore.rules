rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isParentOf(childId) {
      return isSignedIn()
        && userDoc(childId).parentId == request.auth.uid;
    }

    match /users/{userId} {
      // Para queries (list), a condição precisa ser provável a partir dos
      // filtros da própria query. Por isso comparamos direto com parentId.
      allow read: if isSignedIn()
        && (request.auth.uid == userId
            || resource.data.parentId == request.auth.uid);

      // Cadastro no primeiro login (Google ou e-mail).
      // Pai entra direto; filho precisa de um código de convite válido.
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && (
          (request.resource.data.role == 'PARENT'
            && request.resource.data.parentId == null)
          ||
          (request.resource.data.role == 'CHILD'
            && request.resource.data.parentId is string
            && request.resource.data.inviteCode is string
            && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.parentId
                 == request.resource.data.parentId)
        );

      allow update: if (
        // Pai edita o próprio perfil (nome, meta, taxa e convite).
        (request.auth.uid == userId
          && resource.data.role == 'PARENT'
          && request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly([
                 'name', 'goalName', 'goalTargetCents',
                 'weeklyInterestRatePercent', 'lastInterestAppliedAt',
                 'inviteCode'
               ]))
        ||
        // Filho edita apenas nome e meta; nunca saldo ou taxa.
        (request.auth.uid == userId
          && resource.data.role == 'CHILD'
          && request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly(['name', 'goalName', 'goalTargetCents']))
        ||
        // Pai edita saldo, meta e taxa do filho.
        (isParentOf(userId)
          && request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly([
                 'name', 'goalName', 'goalTargetCents',
                 'balanceCents', 'weeklyInterestRatePercent'
               ]))
      );

      allow delete: if false;
    }

    // Códigos de convite ligam um filho novo ao pai.
    // Leitura por ID (get) é liberada para permitir o cadastro.
    match /invites/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create, update: if isSignedIn()
        && request.resource.data.parentId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.parentId == request.auth.uid;
    }

    match /transactions/{transactionId} {
      // childId/parentId permitem que as queries do app sejam validadas
      // sem depender de get() em operações de list.
      allow read: if isSignedIn()
        && (resource.data.childId == request.auth.uid
            || resource.data.parentId == request.auth.uid);

      allow create: if isSignedIn() && (
        // Filho cria somente pedido pendente de saque.
        (request.resource.data.childId == request.auth.uid
          && request.resource.data.parentId
               == userDoc(request.auth.uid).parentId
          && request.resource.data.type == 'WITHDRAW'
          && request.resource.data.status == 'PENDING'
          && request.resource.data.amountCents is int
          && request.resource.data.amountCents > 0)
        ||
        // Pai cria depósito/rendimento já aprovado para o próprio filho.
        (userDoc(request.resource.data.childId).parentId
               == request.auth.uid
          && request.resource.data.parentId == request.auth.uid
          && request.resource.data.status == 'APPROVED'
          && request.resource.data.type in ['DEPOSIT', 'INTEREST']
          && request.resource.data.amountCents is int
          && request.resource.data.amountCents > 0)
      );

      allow update: if isSignedIn()
        && resource.data.parentId == request.auth.uid
        && resource.data.status == 'PENDING'
        && request.resource.data.status in ['APPROVED', 'DENIED']
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly(['status']);

      allow delete: if false;
    }
  }
}
