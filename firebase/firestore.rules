rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isParentOf(childId) {
      return isSignedIn()
        && userDoc(childId).parentId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isSignedIn()
        && (request.auth.uid == userId || isParentOf(userId));

      // Neste MVP as contas são criadas no Console/Admin SDK.
      allow create, delete: if false;

      allow update: if (
        // Filho edita apenas nome e meta; nunca o próprio saldo.
        (request.auth.uid == userId
          && request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly(['name', 'goalName', 'goalTargetCents']))
        ||
        // Pai edita saldo e meta do filho.
        (isParentOf(userId)
          && request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly(['name', 'goalName', 'goalTargetCents', 'balanceCents']))
      );
    }

    match /transactions/{transactionId} {
      allow read: if isSignedIn()
        && (resource.data.childId == request.auth.uid
            || isParentOf(resource.data.childId));

      allow create: if isSignedIn() && (
        // Filho cria somente pedido pendente de saque.
        (request.resource.data.childId == request.auth.uid
          && request.resource.data.type == 'WITHDRAW'
          && request.resource.data.status == 'PENDING'
          && request.resource.data.amountCents is int
          && request.resource.data.amountCents > 0)
        ||
        // Pai cria depósito/rendimento já aprovado.
        (isParentOf(request.resource.data.childId)
          && request.resource.data.status == 'APPROVED'
          && request.resource.data.type in ['DEPOSIT', 'INTEREST']
          && request.resource.data.amountCents is int
          && request.resource.data.amountCents > 0)
      );

      allow update: if isParentOf(resource.data.childId)
        && resource.data.status == 'PENDING'
        && request.resource.data.status in ['APPROVED', 'DENIED']
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly(['status']);

      allow delete: if false;
    }
  }
}
